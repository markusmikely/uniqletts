    "markDefs": [],
    "style": "normal"
   },
   {
    "_key": "dbaba8f66e84",
    "_type": "block",
    "children": [
     {
      "_key": "50b69dc240ff0",
      "_type": "span",
      "marks": [],
      "text": "Where we need to perform the contract we are about to enter into or have entered into with you, the named manager or the landlord that appointed us."
     }
    ],
    "level": 1,
    "listItem": "bullet",
    "markDefs": [],
    "style": "normal"
