# Frontend (Vite) — safe to expose in browser
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
VITE_GTM_ID=
VITE_CLARITY_ID=
# Only when the static build is hosted OFF Vercel (e.g. cPanel): point API
# calls at the Vercel deployment that hosts the /api functions. Leave empty
# for Vercel-hosted builds (same-origin).
VITE_API_BASE=

# Server (Vercel only — never prefix with VITE_)
SANITY_API_WRITE_TOKEN=
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=hello@uniqletts.com
